<% layout("/layouts/boilerplate") %>

<body>
    <div class="container-fluid px-4 py-4" style="max-width: 800px;">
        <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-secondary mb-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Listing
        </a>

        <h1 class="mb-2">AI Review Summary</h1>
        <p class="text-muted mb-4">Summary generated from real guest reviews for <strong><%= listing.title %></strong>.</p>

        <div class="card border-0 shadow-sm p-4 mb-4">
            <div class="d-flex align-items-center mb-3">
                <i class="fa fa-robot fa-2x text-primary me-3"></i>
                <div>
                    <h5 class="mb-0">Summary</h5>
                    <span class="badge bg-secondary"><%= result.source %></span>
                </div>
            </div>
            <p class="mb-0" style="white-space: pre-line;"><%= result.summary %></p>
        </div>

        <% if (result.positiveThemes && result.positiveThemes.length > 0) { %>
        <div class="card border-0 shadow-sm p-4 mb-4">
            <h5 class="mb-3 text-success"><i class="fa fa-thumbs-up me-2"></i>What guests loved</h5>
            <div class="d-flex flex-wrap gap-2">
                <% for (const theme of result.positiveThemes) { %>
                <span class="badge bg-success bg-opacity-10 text-success"><%= theme %></span>
                <% } %>
            </div>
        </div>
        <% } %>

        <% if (result.negativeThemes && result.negativeThemes.length > 0) { %>
        <div class="card border-0 shadow-sm p-4 mb-4">
            <h5 class="mb-3 text-danger"><i class="fa fa-thumbs-down me-2"></i>What guests criticized</h5>
            <div class="d-flex flex-wrap gap-2">
                <% for (const theme of result.negativeThemes) { %>
                <span class="badge bg-danger bg-opacity-10 text-danger"><%= theme %></span>
                <% } %>
            </div>
        </div>
        <% } %>

        <div class="alert alert-light border">
            <i class="fa fa-info-circle me-2 text-primary"></i>
            <% if (aiInfo.configured) { %>
            This summary was generated by an AI model (<%= aiInfo.provider %>) using actual review content.
            <% } else { %>
            This summary uses keyword analysis of real reviews. Connect an AI provider (set AI_PROVIDER + AI_API_KEY) for LLM-powered summaries.
            <% } %>
        </div>
    </div>
</body>