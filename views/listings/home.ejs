<% layout("/layouts/boilerplate") %>

<style>
.hero {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80') center/cover;
    opacity: 0.3;
    z-index: 1;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
    padding: 2rem;
}

.hero h1 {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}

.hero p {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    opacity: 0.9;
}

.features {
    padding: 5rem 0;
    background: #f8f9fa;
}

.feature-card {
    text-align: center;
    padding: 2rem;
    border-radius: 12px;
    transition: transform 0.3s ease;
}

.feature-card:hover {
    transform: translateY(-5px);
}

.feature-icon {
    font-size: 3rem;
    color: #ff385c;
    margin-bottom: 1rem;
}
</style>

<div class="hero">
    <div class="hero-content">
        <h1>Find your next stay</h1>
        <p>Search deals on hotels, homes, and much more...</p>
        <a href="/listings" class="btn btn-light btn-lg px-4 py-3">Start exploring</a>
    </div>
</div>

<section class="features">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card bg-white shadow-sm h-100">
                    <div class="feature-icon">
                        <i class="fa fa-home"></i>
                    </div>
                    <h4>Unique Homes</h4>
                    <p>Discover one-of-a-kind homes and experiences around the world.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card bg-white shadow-sm h-100">
                    <div class="feature-icon">
                        <i class="fa fa-star"></i>
                    </div>
                    <h4>Trusted Reviews</h4>
                    <p>Read genuine reviews from real travelers to make informed decisions.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card bg-white shadow-sm h-100">
                    <div class="feature-icon">
                        <i class="fa fa-shield-alt"></i>
                    </div>
                    <h4>Secure Booking</h4>
                    <p>Book with confidence using our secure payment and booking system.</p>
                </div>
            </div>
        </div>
    </div>
</section>

