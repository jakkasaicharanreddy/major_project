<% layout("/layouts/boilerplate") %>

    <body>
        <div class="container-fluid px-4 py-4">
            <div class="row justify-content-center mb-4">
                <div class="col-12 col-md-10 col-lg-8">
                    <h1 class="text-center mb-4">Find Your Perfect Stay</h1>

                    <!-- Search and Filter Form -->
                    <div class="search-filter-container bg-white p-4 rounded-3 shadow-sm mb-4">
                        <form method="GET" action="/listings" class="row g-3">
                            <!-- Search Input -->
                            <div class="col-12 col-md-5">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text" name="search" class="form-control"
                                           placeholder="Search by title, location, or country"
                                           value="<%= search %>">
                                </div>
                            </div>

                            <!-- Price Range -->
                            <div class="col-12 col-md-3">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input type="number" name="minPrice" class="form-control"
                                               placeholder="Min ₹" value="<%= minPrice %>">
                                    </div>
                                    <div class="col-6">
                                        <input type="number" name="maxPrice" class="form-control"
                                               placeholder="Max ₹" value="<%= maxPrice %>">
                                    </div>
                                </div>
                            </div>

                            <!-- Sort Options -->
                            <div class="col-12 col-md-2">
                                <select name="sort" class="form-select">
                                    <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Latest</option>
                                    <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Oldest</option>
                                    <option value="price-low" <%= sort === 'price-low' ? 'selected' : '' %>>Price: Low to High</option>
                                    <option value="price-high" <%= sort === 'price-high' ? 'selected' : '' %>>Price: High to Low</option>
                                </select>
                            </div>

                            <!-- Search Button -->
                            <div class="col-12 col-md-2">
                                <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center">
                                    <i class="fas fa-search"></i>
                                    <span class="d-none d-md-inline ms-1">Search</span>
                                </button>
                            </div>
                        </form>

                        <!-- Active Filters Display -->
                        <% if (search || minPrice || maxPrice || sort !== 'newest') { %>
                        <div class="mt-3 pt-3 border-top">
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <small class="text-muted fw-semibold">Active filters:</small>
                                <% if (search) { %>
                                    <span class="badge bg-primary">Search: "<%= search %>"</span>
                                <% } %>
                                <% if (minPrice) { %>
                                    <span class="badge bg-success">Min: ₹<%= minPrice %></span>
                                <% } %>
                                <% if (maxPrice) { %>
                                    <span class="badge bg-success">Max: ₹<%= maxPrice %></span>
                                <% } %>
                                <% if (sort !== 'newest') { %>
                                    <span class="badge bg-info">
                                        Sort: <%= sort === 'oldest' ? 'Oldest' : sort === 'price-low' ? 'Price: Low to High' : 'Price: High to Low' %>
                                    </span>
                                <% } %>
                                <a href="/listings" class="btn btn-sm btn-outline-secondary ms-auto">
                                    <i class="fas fa-times"></i> Clear All
                                </a>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4 justify-content-center">
                <% for(let listing of allListings){ %>
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm listing-card">
                        <div class="position-relative overflow-hidden rounded-top">
                            <a href="/listings/<%= listing._id %>" style="text-decoration: none; color: inherit; display: block; cursor: pointer; pointer-events: auto;">
                                <img src="<%= listing.image.url %>" class="card-img-top w-100" alt="listing image" style="height: 200px; object-fit: cover; display: block; pointer-events: none;">
                            </a>
                            <% if (curruser) { %>
                            <div style="position: absolute; top: 0.5rem; right: 0.5rem; z-index: 10;">
                                <form method="post" action="/wishlist/<%= listing._id %>" class="d-inline">
                                    <button type="submit" class="btn btn-light btn-sm rounded-circle wishlist-btn" title="Add to Wishlist" style="pointer-events: auto;">
                                        <i class="fa-regular fa-heart"></i>
                                    </button>
                                </form>
                            </div>
                            <% } %>
                        </div>
                        <div class="card-body">
                            <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                                <h6 class="card-title mb-1"><%= listing.title %></h6>
                            </a>
                            <p class="card-text text-muted small mb-1"><%= listing.location %>, <%= listing.country %></p>
                            <p class="card-text fw-bold mb-0">&#8377; <%= listing.price ? listing.price.toLocaleString("en-in") : "N/A" %> <span class="text-muted fw-normal">night</span></p>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>

            <% if (allListings.length === 0) { %>
            <div class="text-center mt-5">
                <p class="text-muted">No listings found. Try adjusting your search.</p>
            </div>
            <% } %>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <% if (hasPrevPage) { %>
                    <li class="page-item">
                        <a class="page-link" href="?page=<%= prevPage %>&search=<%= search %>&sort=<%= sort %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">Previous</a>
                    </li>
                    <% } %>

                    <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %>&search=<%= search %>&sort=<%= sort %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>"><%= i %></a>
                    </li>
                    <% } %>

                    <% if (hasNextPage) { %>
                    <li class="page-item">
                        <a class="page-link" href="?page=<%= nextPage %>&search=<%= search %>&sort=<%= sort %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">Next</a>
                    </li>
                    <% } %>
                </ul>
            </nav>
            <% } %>
        </div>
    </body>