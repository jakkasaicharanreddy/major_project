<% layout("/layouts/boilerplate") %>

<body>
    <div class="container-fluid px-4 py-4">
        <div class="row g-4">
            <!-- Image Column -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <img src="<%= list.image.url %>" class="card-img-top rounded" alt="listing image" style="height: 500px; object-fit: cover;">
                </div>
            </div>

            <!-- Details Column -->
            <div class="col-lg-6">
                <div class="d-flex flex-column h-100">
                    <div class="mb-4">
                        <h1 class="display-5 fw-bold mb-2"><%= list.title %></h1>
                        <% if (list.reviews && list.reviews.length > 0) { %>
                        <p class="mb-2"><span class="text-warning">&#11088; <%= avgRating %> / 5</span> <span class="text-muted">(<%= list.reviews.length %> review<%= list.reviews.length > 1 ? 's' : '' %>)</span></p>
                        <% } else { %>
                        <p class="text-muted mb-2">No reviews yet</p>
                        <% } %>
                        <p class="text-muted mb-3"><i class="fa fa-map-marker-alt me-2"></i><%= list.location %>, <%= list.country %></p>
                        <p class="fs-4 fw-bold text-primary mb-3">&#8377; <%= list.price.toLocaleString("en-in") %> <span class="text-muted fw-normal">per night</span></p>
                        <p class="text-muted mb-3">&#128101; Up to <%= list.maxGuests || 4 %> guests</p>
                        <p class="lead mb-4"><%= list.description %></p>
                        <p class="text-muted small">Hosted by <%= list.owner ? (list.owner.displayName || list.owner.username) : 'Unknown' %></p>
                    </div>

                    <!-- Step 12: Message Host (logged-in non-owners only) -->
                    <% if (curruser && list.owner && !curruser._id.equals(list.owner._id)) { %>
                    <div class="mb-3">
                        <a href="/messages/<%= list._id %>" class="btn btn-outline-primary">
                            <i class="fa-regular fa-envelope me-1"></i> Message Host
                        </a>
                    </div>
                    <% } %>

                    <!-- Booking Section -->
                    <div class="mt-auto">
                        <% if (curruser && list.owner && curruser._id.equals(list.owner._id)) { %>
                        <div class="card border-0 shadow-sm p-4 mb-4">
                            <h5 class="mb-3">Reserve your stay</h5>
                            <p class="text-muted mb-0">You own this listing.</p>
                        </div>
                        <% } else { %>
                        <div class="card border-0 shadow-sm p-4 mb-4">
                            <h5 class="mb-3">Reserve your stay</h5>
                            <p class="text-muted small mb-3">Some dates may already be unavailable. Check the unavailable dates below before booking.</p>
                            <form action="/bookings/<%= list._id %>" method="post" class="booking-form" data-price="<%= list.price %>" data-blocked-dates='<%- JSON.stringify(blockedDates || []) %>'>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label for="checkin" class="form-label">Check-in</label>
                                        <input type="date" class="form-control" id="checkin" name="checkIn" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="checkout" class="form-label">Check-out</label>
                                        <input type="date" class="form-control" id="checkout" name="checkOut" required>
                                    </div>
                                    <div class="col-12">
                                        <label for="guests" class="form-label">Guests</label>
                                        <select class="form-select" id="guests" name="guests">
                                            <% const maxGuests = list.maxGuests || 4; %>
                                            <% for (let i = 1; i <= maxGuests; i++) { %>
                                            <option value="<%= i %>"><%= i %> guest<%= i > 1 ? 's' : '' %></option>
                                            <% } %>
                                        </select>
                                    </div>
                                </div>
                                <div id="booking-date-error" class="alert alert-danger d-none py-2 px-3 mb-3 small"></div>
                                <button type="submit" class="btn btn-primary w-100 py-3 fs-5" data-booking-submit>Book Now</button>
                            </form>
                            <div id="booking-summary" class="booking-summary d-none mt-3">
                                <p class="mb-1" id="summary-nights"></p>
                                <p class="mb-0 fw-bold" id="summary-total"></p>
                            </div>
                            <div class="mt-3">
                                <h6 class="mb-2 small text-muted text-uppercase">Unavailable dates</h6>
                                <% if (blockedDates && blockedDates.length > 0) { %>
                                <ul class="list-unstyled mb-0 small">
                                    <% for (const range of blockedDates) { %>
                                    <% const rangeCheckIn = new Date(range.checkIn + "T00:00:00"); %>
                                    <% const rangeCheckOut = new Date(range.checkOut + "T00:00:00"); %>
                                    <li class="mb-1">
                                        <span class="text-danger">&#128197;</span>
                                        <%= rangeCheckIn.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %> — <%= rangeCheckOut.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %>
                                    </li>
                                    <% } %>
                                </ul>
                                <% } else { %>
                                <p class="text-muted small mb-0">No existing bookings — dates are currently open.</p>
                                <% } %>
                            </div>
                        </div>
                        <% } %>

                        <% if (curruser && curruser._id.equals(list.owner._id)) { %>
                        <div class="d-flex gap-2">
                            <a href="/listings/<%= list._id %>/edit" class="btn btn-outline-secondary flex-fill">Edit Listing</a>
                            <form method="post" action="/listings/<%= list._id %>?_method=DELETE" class="flex-fill">
                                <button type="submit" class="btn btn-outline-danger w-100">Delete Listing</button>
                            </form>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reviews Section -->
        <hr class="my-5">
        <div class="row">
            <div class="col-12">
                <h2 class="mb-4">Reviews</h2>
                <% const reviewCount = list.reviews.length; %>
                <% const starCounts = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 }; %>
                <% for (const review of list.reviews) { if (starCounts[review.rating] !== undefined) { starCounts[review.rating]++; } } %>
                <% if (reviewCount > 0) { %>
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h6 class="mb-3">Rating Distribution</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-1">&#11088; 5 stars: <%= starCounts[5] %></li>
                        <li class="mb-1">&#11088; 4 stars: <%= starCounts[4] %></li>
                        <li class="mb-1">&#11088; 3 stars: <%= starCounts[3] %></li>
                        <li class="mb-1">&#11088; 2 stars: <%= starCounts[2] %></li>
                        <li class="mb-0">&#11088; 1 star: <%= starCounts[1] %></li>
                    </ul>
                </div>
                <% } %>
                <% if (curruser) { %>
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="mb-3">Leave a review</h5>
                    <form action="/listings/<%= list._id %>/reviews" method="post" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label for="rating" class="form-label">Rating</label>
                            <fieldset class="starability-slot">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>
                        <div class="mb-3">
                            <label for="comment" class="form-label">Comment</label>
                            <textarea name="review[comment]" id="comment" class="form-control" rows="3" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Submit Review</button>
                    </form>
                </div>
                <% } %>

                <% if (reviewCount === 0) { %>
                <div class="card border-0 shadow-sm p-4">
                    <p class="text-muted mb-0">No reviews yet. Be the first to review this listing!</p>
                </div>
                <% } else { %>
                <div class="row g-4">
                    <% for(let review of list.reviews){ %>
                    <% const reviewDate = review.createdAt ? new Date(review.createdAt).toLocaleDateString("en-IN", { year: "numeric", month: "short", day: "numeric" }) : ""; %>
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <h6 class="card-title mb-0"><%= review.owner ? review.owner.username : 'Anonymous' %></h6>
                                    <% if (reviewDate) { %>
                                    <span class="text-muted small ms-2">&#128197; <%= reviewDate %></span>
                                    <% } %>
                                </div>
                                <p class="starability-result mb-2" data-rating="<%= review.rating %>">Rated: <%= review.rating %> stars</p>
                                <p class="card-text"><%= review.comment %></p>
                                <% if (curruser && ((review.owner && curruser._id.equals(review.owner._id)) || curruser._id.equals(list.owner._id))) { %>
                                <form method="post" action="/listings/<%= list._id %>/reviews/<%= review._id %>?_method=DELETE" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
                <% } %>
            </div>
        <!-- Map Section -->
        <hr class="my-5">
        <div class="row">
            <div class="col-12">
                <h2 class="mb-4">Location</h2>
                <div id="map" style="height: 400px; width: 100%; border-radius: 12px;" class="shadow-sm"></div>
            </div>
        </div>

        <script>
            function initMap() {
                // Placeholder for Google Maps integration
                // Replace with actual API key and coordinates
                const mapElement = document.getElementById('map');
                mapElement.innerHTML = '<div class="d-flex align-items-center justify-content-center h-100 bg-light rounded"><p class="text-muted mb-0">Map integration requires Google Maps API key</p></div>';
            }
            window.onload = initMap;
        </script>
    </div> <!-- container-fluid -->
</body>