<% layout("/layouts/boilerplate") %>

<body>
    <div class="container-fluid px-4 py-4">
        <h1 class="mb-2">Notifications</h1>

        <% if (notifications.length === 0) { %>
        <div class="text-center mt-5">
            <i class="fa fa-bell fa-3x text-muted mb-3"></i>
            <h3 class="text-muted">You don't have any notifications yet.</h3>
            <p class="text-muted">Booking updates will show up here.</p>
            <a href="/listings" class="btn btn-primary">Browse Listings</a>
        </div>
        <% } else { %>
        <% if (unreadCount > 0) { %>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <p class="text-muted mb-0"><%= unreadCount %> unread notification<%= unreadCount > 1 ? 's' : '' %></p>
            <form method="post" action="/notifications/read-all">
                <button type="submit" class="btn btn-sm btn-outline-primary">Mark all as read</button>
            </form>
        </div>
        <% } %>

        <div class="row g-4">
            <% for (let notification of notifications) { %>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 <%= notification.isRead ? 'border-0 shadow-sm' : 'shadow-sm border-start border-primary border-4' %>">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="card-title mb-0"><%= notification.message %></h6>
                            <% if (!notification.isRead) { %>
                            <span class="badge bg-primary">New</span>
                            <% } %>
                        </div>
                        <% if (notification.listing) { %>
                        <p class="card-text text-muted small mb-1">
                            <strong>Listing:</strong> <%= notification.listing.title %>
                        </p>
                        <% } %>
                        <p class="card-text text-muted small mb-2">
                            <strong><%= notification.createdAt.toDateString() %></strong> at <%= notification.createdAt.toLocaleTimeString() %>
                        </p>
                        <div class="d-flex gap-2">
                            <a href="/dashboard" class="btn btn-sm btn-outline-secondary flex-fill">View Dashboard</a>
                            <% if (!notification.isRead) { %>
                            <form method="post" action="/notifications/<%= notification._id %>/read" class="flex-fill">
                                <button type="submit" class="btn btn-sm btn-outline-primary w-100">Mark as read</button>
                            </form>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
        <% } %>
    </div>
</body>