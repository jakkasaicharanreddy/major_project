<% layout("/layouts/boilerplate") %>

<body>
    <div class="container-fluid px-4 py-4">
        <h1 class="mb-4">My Wishlist</h1>

        <% if (wishlist.listings.length === 0) { %>
        <div class="text-center mt-5">
            <i class="fa fa-heart-o fa-3x text-muted mb-3"></i>
            <h3 class="text-muted">Your wishlist is empty</h3>
            <p class="text-muted">Start adding listings you love!</p>
            <a href="/listings" class="btn btn-primary">Browse Listings</a>
        </div>
        <% } else { %>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            <% for(let listing of wishlist.listings){ %>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm listing-card">
                    <div class="position-relative">
                        <img src="<%= listing.image.url %>" class="card-img-top rounded-top" alt="listing image" style="height: 200px; object-fit: cover;">
                        <div class="card-img-overlay d-flex align-items-start justify-content-end p-2">
                            <form method="post" action="/wishlist/<%= listing._id %>?_method=DELETE" class="d-inline">
                                <button type="submit" class="btn btn-light btn-sm rounded-circle">
                                    <i class="fa fa-heart text-danger"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="card-body">
                        <h6 class="card-title mb-1"><%= listing.title %></h6>
                        <p class="card-text text-muted small mb-1"><%= listing.location %>, <%= listing.country %></p>
                        <p class="card-text fw-bold mb-0">&#8377; <%= listing.price ? listing.price.toLocaleString("en-in") : "N/A" %> <span class="text-muted fw-normal">night</span></p>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
        <% } %>
    </div>
</body>